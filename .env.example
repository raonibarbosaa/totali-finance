# ── Banco de Dados ─────────────────────────────────────────
# IMPORTANTE: Troque por uma senha forte antes de subir em produção
POSTGRES_PASSWORD=troque_por_senha_forte_aqui

# ── JWT ────────────────────────────────────────────────────
# IMPORTANTE: Gere chaves aleatórias (ex: openssl rand -hex 64)
JWT_SECRET=gere_uma_chave_aleatoria_forte_aqui
REFRESH_TOKEN_SECRET=gere_outra_chave_aleatoria_forte_aqui

# ── URL do sistema ─────────────────────────────────────────
FRONTEND_URL=https://app.totalicontabilidade.com.br

# ── E-mail (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.seuprovedor.com.br
SMTP_PORT=587
SMTP_USER=noreply@totalicontabilidade.com.br
SMTP_PASS=senha_do_smtp
EMAIL_FROM=TotaliFinance <noreply@totalicontabilidade.com.br>
EMAIL_ADMIN=financeiro@totalicontabilidade.com.br

# ── Recuperação de senha ───────────────────────────────────
# Validade do link "esqueci minha senha", em minutos
RESET_TOKEN_EXPIRES_MIN=60
