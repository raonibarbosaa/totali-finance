generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String   @id @default(uuid())
  razaoSocial   String   @map("razao_social") @db.VarChar(200)
  nomeFantasia  String?  @map("nome_fantasia") @db.VarChar(200)
  cnpj          String   @unique @db.VarChar(18)
  codigoFilial  String?  @map("codigo_filial") @db.VarChar(20)
  regime        String   @default("caixa") @db.VarChar(12)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  userRoles         UserTenantRole[]
  bankAccounts      BankAccount[]
  categories        Category[]
  ofxPatterns       OfxPattern[]
  transactions      Transaction[]
  titles            Title[]
  recurringTitles   RecurringTitle[]
  ofxImports        OfxImport[]
  ofxEntries        OfxEntry[]
  stockAdjustments  StockAdjustment[]
  balanceAdjustments BalanceAdjustment[]
  creditCards       CreditCard[]
  cardStatements    CardStatement[]
  cardStatementEntries CardStatementEntry[]
  cardPatterns      CardPattern[]
  periodClosings    PeriodClosing[]
  exportLogs        ExportLog[]
  notifications     Notification[]

  suppliers         Supplier[]
  customers         Customer[]

  driveConfig       DriveConfig?
  ofxImportLogs     OfxImportLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  nome         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(150)
  senhaHash    String   @map("senha_hash") @db.VarChar(255)
  perfil       String   @db.VarChar(25)
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  tenantRoles        UserTenantRole[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  transactionsCriadas Transaction[] @relation("TransacaoCriadaPor")
  titlesCriados       Title[]       @relation("TituloCriadoPor")
  recurringCriados    RecurringTitle[] @relation("RecurringCriadoPor")
  stocksCriados       StockAdjustment[]
  ajustesSaldoCriados BalanceAdjustment[]
  faturasImportadas   CardStatement[]
  periodsFechados     PeriodClosing[]  @relation("FechadoPor")
  periodsReabertos    PeriodClosing[]  @relation("ReabertoPor")
  exportacoes         ExportLog[]
  ofxImports          OfxImport[]
  vinculosFeitos      UserTenantRole[] @relation("VinculadoPor")

  @@map("users")
}

model UserTenantRole {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  tenantId    String   @map("tenant_id")
  role        Int
  vinculadoPor String? @map("vinculado_por")
  criadoEm   DateTime @default(now()) @map("criado_em")

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vinculador User?  @relation("VinculadoPor", fields: [vinculadoPor], references: [id])

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenant_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiraEm  DateTime @map("expira_em")
  criadoEm  DateTime @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model BankAccount {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  nome              String   @db.VarChar(100)
  banco             String?  @db.VarChar(100)
  agencia           String?  @db.VarChar(20)
  conta             String?  @db.VarChar(30)
  tipo              String   @db.VarChar(20)
  saldoInicial      Decimal  @default(0) @map("saldo_inicial") @db.Decimal(15, 2)
  dataSaldoInicial  DateTime? @map("data_saldo_inicial") @db.Date
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now()) @map("criado_em")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
  titles       Title[]
  ofxImports   OfxImport[]
  ofxEntries   OfxEntry[]
  balanceAdjustments BalanceAdjustment[]
  creditCards  CreditCard[]

  @@index([tenantId])
  @@map("bank_accounts")
}

model Category {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  nome           String   @db.VarChar(150)
  tipo           String   @db.VarChar(20)
  natureza       String   @db.VarChar(10)
  subtipo        String   @default("operacional") @db.VarChar(30)
  contaDebito    String?  @map("conta_debito") @db.VarChar(20)
  contaCredito   String?  @map("conta_credito") @db.VarChar(20)
  codHistorico   String?  @map("cod_historico") @db.VarChar(20)
  centroCustoD   String?  @map("centro_custo_d") @db.VarChar(20)
  centroCustoC   String?  @map("centro_custo_c") @db.VarChar(20)
  flagMercadoria Boolean  @default(false) @map("flag_mercadoria")
  dfcType        String?  @default("OPERACIONAL") @map("dfc_type") @db.VarChar(20)
  // Marca as categorias criadas e mantidas pelo sistema, como as do ajuste de
  // saldo ('ajuste_entrada' e 'ajuste_saida'). Categoria comum fica NULL.
  // Serve para encontrá-las sem depender do nome, que o usuário pode renomear,
  // e para impedir que sejam excluídas ou tenham o tipo trocado.
  codigoSistema  String?  @map("codigo_sistema") @db.VarChar(30)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  transactions    Transaction[]
  titles          Title[]
  recurringTitles RecurringTitle[]
  ofxPatterns     OfxPattern[]
  ofxEntriesSugeridas OfxEntry[] @relation("OfxEntrySuggestedCategory")
  cardEntries     CardStatementEntry[]
  cardPatterns    CardPattern[]
  cartoesFatura   CreditCard[] @relation("CategoriaFaturaCartao")

  @@index([tenantId])
  // Garante UMA categoria de cada código por empresa. Em Postgres, NULL não
  // conflita com NULL, então as categorias comuns não são afetadas.
  @@unique([tenantId, codigoSistema])
  @@map("categories")
}

model OfxPattern {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  textoHistorico  String   @map("texto_historico") @db.VarChar(255)
  categoryId      String   @map("category_id")
  complementoAuto String?  @map("complemento_auto") @db.VarChar(255)
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now()) @map("criado_em")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@index([tenantId])
  @@map("ofx_patterns")
}

model Transaction {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  bankAccountId   String?  @map("bank_account_id")
  categoryId      String?  @map("category_id")
  tipo            String   @db.VarChar(20)
  dataLancamento  DateTime @map("data_lancamento") @db.Date
  dataCompetencia DateTime? @map("data_competencia") @db.Date
  valor           Decimal  @db.Decimal(15, 2)
  descricao       String?  @db.VarChar(255)
  complemento     String?  @db.VarChar(500)
  contaDebito     String?  @map("conta_debito") @db.VarChar(20)
  contaCredito    String?  @map("conta_credito") @db.VarChar(20)
  codHistorico    String?  @map("cod_historico") @db.VarChar(20)
  centroCustoD    String?  @map("centro_custo_d") @db.VarChar(20)
  centroCustoC    String?  @map("centro_custo_c") @db.VarChar(20)
  status          String   @default("realizado") @db.VarChar(20)
  origem          String   @default("manual") @db.VarChar(20)
  ofxImportId     String?  @map("ofx_import_id")
  tituloId        String?  @map("titulo_id")
  customerId      String?  @map("customer_id")
  supplierId      String?  @map("supplier_id")
  exportado       Boolean  @default(false)
  conciliadoEm    DateTime? @map("conciliado_em")
  criadoPor       String?  @map("criado_por")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  criador     User?        @relation("TransacaoCriadaPor", fields: [criadoPor], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  ofxEntry    OfxEntry?

  @@index([tenantId])
  @@index([tenantId, dataLancamento])
  @@index([tenantId, bankAccountId])
  @@index([tenantId, status])
  @@index([tenantId, exportado])
  @@index([tenantId, customerId])
  @@index([tenantId, supplierId])
  @@index([tenantId, conciliadoEm])
  @@map("transactions")
}

model Title {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  categoryId       String?   @map("category_id")
  bankAccountId    String?   @map("bank_account_id")
  recurringTitleId String?   @map("recurring_title_id")
  tipo             String    @db.VarChar(10)
  descricao        String    @db.VarChar(255)
  valor            Decimal   @db.Decimal(15, 2)
  dataEmissao      DateTime  @map("data_emissao") @db.Date
  dataVencimento   DateTime  @map("data_vencimento") @db.Date
  dataPagamento    DateTime? @map("data_pagamento") @db.Date
  status           String    @default("aberto") @db.VarChar(20)
  numeroDocumento  String?   @map("numero_documento") @db.VarChar(100)
  nomeContato      String?   @map("nome_contato") @db.VarChar(200)
  observacao       String?   @db.Text
  transactionId    String?   @map("transaction_id")

  // Cadastros (Etapa 4.2)
  supplierId          String?  @map("supplier_id")
  customerId          String?  @map("customer_id")

  // Parcelamento (Etapa 4.1)
  grupoParcelamentoId String?  @map("grupo_parcelamento_id")
  parcelaNumero       Int?     @map("parcela_numero")
  parcelaTotal        Int?     @map("parcela_total")
  valorTotalGrupo     Decimal? @db.Decimal(15, 2) @map("valor_total_grupo")

  criadoPor        String?   @map("criado_por")
  criadoEm         DateTime  @default(now()) @map("criado_em")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  bankAccount    BankAccount?    @relation(fields: [bankAccountId], references: [id])
  recurringTitle RecurringTitle? @relation(fields: [recurringTitleId], references: [id])
  criador        User?           @relation("TituloCriadoPor", fields: [criadoPor], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])

  @@unique([recurringTitleId, dataVencimento])
  @@index([tenantId, status])
  @@index([tenantId, dataVencimento])
  @@index([tenantId, grupoParcelamentoId])
  @@map("titles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Templates de títulos recorrentes (Contas a Pagar/Receber Fixas)
//
// Cada registro descreve um template de título que se repete numa cadência
// definida (semanal/quinzenal/mensal/anual). Os títulos efetivos são gerados
// sob demanda no titles.service.list() — ver gerarOcorrenciasPendentes().
//
// `dataFimGeracao` é preenchida quando o usuário cancela: a partir dessa data,
// nenhuma nova ocorrência é gerada, mas títulos já gerados ficam intactos.
//
// Edição em uma ocorrência específica afeta APENAS aquela ocorrência (já que
// é uma linha em `titles`); o template continua gerando as próximas com os
// valores originais.
//
// `diaVencimento` interpretação por frequencia:
//   mensal     → dia do mês (1-31)
//   anual      → dia do mês (1-31), gerado todo ano no mesmo mês de dataInicio
//   semanal    → dia da semana (0=domingo a 6=sábado)
//   quinzenal  → dia da semana (0=domingo a 6=sábado), 1x a cada 14 dias
// ─────────────────────────────────────────────────────────────────────────────
model RecurringTitle {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  categoryId      String?   @map("category_id")
  tipo            String    @db.VarChar(10)
  descricao       String    @db.VarChar(255)
  valor           Decimal   @db.Decimal(15, 2)
  numeroDocumento String?   @map("numero_documento") @db.VarChar(100)
  nomeContato     String?   @map("nome_contato") @db.VarChar(200)
  observacao      String?   @db.Text
  frequencia      String    @db.VarChar(15)
  diaVencimento   Int       @map("dia_vencimento")
  dataInicio      DateTime  @map("data_inicio") @db.Date
  dataFimGeracao  DateTime? @map("data_fim_geracao") @db.Date
  ativo           Boolean   @default(true)
  criadoPor       String?   @map("criado_por")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  criador  User?     @relation("RecurringCriadoPor", fields: [criadoPor], references: [id])
  titles   Title[]

  @@index([tenantId, ativo])
  @@map("recurring_titles")
}

model OfxImport {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  bankAccountId  String   @map("bank_account_id")
  nomeArquivo    String?  @map("nome_arquivo") @db.VarChar(255)
  hashArquivo    String?  @map("hash_arquivo") @db.VarChar(64)
  dataInicio     DateTime? @map("data_inicio") @db.Date
  dataFim        DateTime? @map("data_fim") @db.Date
  totalRegistros Int?     @map("total_registros")
  conciliados    Int?     @default(0)
  pendentes      Int?     @default(0)
  importadoPor   String?  @map("importado_por")
  importadoEm    DateTime @default(now()) @map("importado_em")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  importador  User?       @relation(fields: [importadoPor], references: [id])
  entries     OfxEntry[]

  @@unique([tenantId, hashArquivo])
  @@map("ofx_imports")
}

// ─────────────────────────────────────────────────────────────────────────────
// OfxEntry — uma linha individual de extrato OFX importado.
//
// Cada arquivo OFX gera 1 OfxImport (cabeçalho) + N OfxEntries (uma por
// transação do arquivo). Cada entry pode estar:
//   • pendente   — ainda não vinculada a um Transaction
//   • conciliado — vinculada a um Transaction (auto ou manualmente)
//   • ignorado   — usuário marcou como "não vai virar lançamento"
//
// Dedup: `(bankAccountId, fitid)` é único — a mesma transação OFX (mesmo FITID)
// nunca aparece duas vezes na mesma conta, mesmo se importada em arquivos
// distintos.
//
// `transactionId` é único — relação 1-para-1 com Transaction. N-para-1 e 1-para-N
// não estão suportados nesta etapa (planejado para versões futuras).
//
// `suggestedCategoryId` é preenchido pelo casamento com OfxPattern e serve como
// pré-seleção no quick-create da Etapa 5C (não é vinculação obrigatória).
// ─────────────────────────────────────────────────────────────────────────────
model OfxEntry {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  ofxImportId         String   @map("ofx_import_id")
  bankAccountId       String   @map("bank_account_id")
  fitid               String   @db.VarChar(255)
  dataMovimento       DateTime @map("data_movimento") @db.Date
  valor               Decimal  @db.Decimal(15, 2)
  tipo                String   @db.VarChar(20)
  descricao           String?  @db.VarChar(500)
  memo                String?  @db.VarChar(500)
  status              String   @default("pendente") @db.VarChar(20)
  transactionId       String?  @unique @map("transaction_id")
  suggestedCategoryId String?  @map("suggested_category_id")
  conciliadoEm        DateTime? @map("conciliado_em")
  ignoradoEm          DateTime? @map("ignorado_em")
  // Por que foi ignorada. Distingue o que o usuario ignorou a mao do que o
  // sistema cortou por ser anterior a um ajuste de saldo da conta.
  motivoIgnorado      String?  @map("motivo_ignorado") @db.VarChar(120)
  criadoEm            DateTime @default(now()) @map("criado_em")

  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  ofxImport         OfxImport    @relation(fields: [ofxImportId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount  @relation(fields: [bankAccountId], references: [id])
  transaction       Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  suggestedCategory Category?    @relation("OfxEntrySuggestedCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)

  @@unique([bankAccountId, fitid])
  @@index([tenantId, status])
  @@index([ofxImportId])
  @@map("ofx_entries")
}

model StockAdjustment {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  competencia  DateTime @db.Date
  valorEstoque Decimal  @map("valor_estoque") @db.Decimal(15, 2)
  observacao   String?  @db.VarChar(500)
  criadoPor    String?  @map("criado_por")
  criadoEm     DateTime @default(now()) @map("criado_em")

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  criador User?  @relation(fields: [criadoPor], references: [id])

  @@map("stock_adjustments")
}

// ─────────────────────────────────────────────────────────────────────────
// BalanceAdjustment — trilha de auditoria do ajuste de saldo bancario.
//
// O saldo nao existe como coluna: e sempre derivado de
// saldoInicial + receitas - despesas. Entao um ajuste e, na pratica, um
// Transaction com origem='ajuste'. Esta tabela guarda o CONTEXTO que o
// lancamento sozinho nao carrega: qual era o saldo do sistema, qual era o
// saldo real do banco, e por que foi ajustado.
//
// saldoSistema e saldoReal sao FOTOGRAFIAS do momento da decisao. Recalcular
// o saldo daquela data meses depois pode dar outro numero, porque lancamentos
// antigos podem ter entrado no meio tempo. A fotografia preserva o que o
// operador via na tela.
// ─────────────────────────────────────────────────────────────────────────
model BalanceAdjustment {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  bankAccountId String   @map("bank_account_id")
  transactionId String?  @map("transaction_id")
  dataAjuste    DateTime @map("data_ajuste") @db.Date
  saldoSistema  Decimal  @map("saldo_sistema") @db.Decimal(15, 2)
  saldoReal     Decimal  @map("saldo_real")    @db.Decimal(15, 2)
  diferenca     Decimal  @db.Decimal(15, 2)
  motivo        String   @db.VarChar(500)
  // Quando este ajuste e o estorno de outro, aponta pro original.
  estornoDe     String?  @map("estorno_de")
  criadoPor     String?  @map("criado_por")
  criadoEm      DateTime @default(now()) @map("criado_em")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  criador     User?       @relation(fields: [criadoPor], references: [id])

  @@index([tenantId, bankAccountId])
  @@map("balance_adjustments")
}

// ─────────────────────────────────────────────────────────────────────────
// CARTÃO DE CRÉDITO
//
// Cartão é model proprio, e nao um tipo de BankAccount. Cartao nao tem saldo,
// tem limite e fatura. Se entrasse como conta bancaria, o dashboard e o ajuste
// de saldo somariam o cartao ao caixa da empresa e distorceriam o saldo.
//
// O elo com o banco e o bankAccountId: a conta DE ONDE a fatura e paga. Assim o
// pagamento da fatura vira lancamento normal na conta corrente e continua
// conciliando com o OFX.
// ─────────────────────────────────────────────────────────────────────────
model CreditCard {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  nome          String   @db.VarChar(100)
  // Qual leitor de PDF usar.
  //   'auto'     -> detecta pelo conteudo do arquivo (padrao)
  //   'cora'     -> forca o leitor da Cora
  //   'generico' -> forca o leitor generico, para quando o proprio leitor do
  //                 emissor estiver errando naquele arquivo
  emissor       String   @default("auto") @db.VarChar(30)
  bandeira      String?  @db.VarChar(20)
  ultimos4      String?  @map("ultimos_4") @db.VarChar(4)
  limite        Decimal? @db.Decimal(15, 2)
  diaFechamento Int?     @map("dia_fechamento")
  diaVencimento Int?     @map("dia_vencimento")
  // Conta de onde a fatura e paga. Opcional: nem todo cartao tem conta fixa.
  bankAccountId String?  @map("bank_account_id")
  // Conta contabil de "cartao a pagar". Vai no CREDITO de cada compra: a
  // despesa e debitada na conta da categoria e creditada aqui, porque o
  // dinheiro ainda nao saiu do banco.
  contaCartao   String?  @map("conta_cartao") @db.VarChar(20)
  // Categoria do TITULO gerado para o pagamento da fatura. Quando o titulo e
  // baixado, ela da a codificacao: debita cartao a pagar, credita o banco.
  categoryIdFatura String? @map("category_id_fatura")
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id])
  categoryFatura Category?    @relation("CategoriaFaturaCartao", fields: [categoryIdFatura], references: [id])
  statements     CardStatement[]
  entries        CardStatementEntry[]

  @@index([tenantId, ativo])
  @@map("credit_cards")
}

/// Uma fatura importada. Espelha OfxImport.
model CardStatement {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  creditCardId     String   @map("credit_card_id")
  nomeArquivo      String?  @map("nome_arquivo") @db.VarChar(255)
  hashArquivo      String   @map("hash_arquivo") @db.VarChar(64)
  emissorDetectado String?  @map("emissor_detectado") @db.VarChar(30)
  competencia      DateTime? @db.Date
  dataVencimento   DateTime? @map("data_vencimento") @db.Date
  // Total lido do cabecalho do PDF. Serve de CONFERENCIA: se a soma das linhas
  // nao bater com ele, o leitor errou, e a tela mostra a diferenca.
  valorTotalInformado Decimal? @map("valor_total_informado") @db.Decimal(15, 2)
  totalLinhas      Int      @default(0) @map("total_linhas")
  importadoPor     String?  @map("importado_por")
  importadoEm      DateTime @default(now()) @map("importado_em")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  creditCard CreditCard  @relation(fields: [creditCardId], references: [id])
  importador User?       @relation(fields: [importadoPor], references: [id])
  entries    CardStatementEntry[]

  @@unique([tenantId, hashArquivo])
  @@index([tenantId, creditCardId])
  @@map("card_statements")
}

/// Cada linha da fatura.
model CardStatementEntry {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  cardStatementId String   @map("card_statement_id")
  creditCardId    String   @map("credit_card_id")
  dataCompra      DateTime @map("data_compra") @db.Date
  descricao       String   @db.VarChar(500)
  valor           Decimal  @db.Decimal(15, 2)
  /// compra | estorno | pagamento | encargo
  tipo            String   @db.VarChar(20)
  parcelaNumero   Int?     @map("parcela_numero")
  parcelaTotal    Int?     @map("parcela_total")
  // Portador do cartao adicional. Fatura de cartao empresarial lista as
  // compras agrupadas por pessoa, e saber quem gastou o que e metade do valor
  // do controle.
  portador        String?  @db.VarChar(120)
  // Preenchidos na Etapa 2 (de-para e geracao de lancamentos). Ja nascem aqui
  // para nao exigir outra migracao depois.
  categoryId      String?  @map("category_id")
  supplierId      String?  @map("supplier_id")
  // Texto vindo do de-para, aplicado no complemento do lancamento gerado.
  complementoAuto String?  @map("complemento_auto") @db.VarChar(255)
  transactionId   String?  @map("transaction_id")
  /// pendente | classificado | ignorado
  status          String   @default("pendente") @db.VarChar(20)
  // Chave de deduplicacao na reimportacao. Data + descricao + valor nao bastam:
  // duas compras iguais no mesmo dia existem. O hash inclui a ordem da linha.
  hashLinha       String   @map("hash_linha") @db.VarChar(64)
  criadoEm        DateTime @default(now()) @map("criado_em")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  cardStatement CardStatement @relation(fields: [cardStatementId], references: [id], onDelete: Cascade)
  creditCard    CreditCard    @relation(fields: [creditCardId], references: [id])
  category      Category?     @relation(fields: [categoryId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])

  @@unique([creditCardId, hashLinha])
  @@index([tenantId, cardStatementId])
  @@map("card_statement_entries")
}

/// De-para do cartao: texto do estabelecimento -> categoria e fornecedor.
///
/// Separado do de-para de OFX de proposito: nome de loja nao se mistura com
/// historico bancario, e um padrao generico criado para extrato classificaria
/// errado uma compra de cartao.
///
/// Corrige dois defeitos do de-para de OFX:
///   - la o empate entre dois padroes e resolvido pela ordem que o banco
///     devolve, que e arbitraria. Aqui ha prioridade, e no empate vence o
///     texto mais longo (o mais especifico)
///   - la o complementoAuto e cadastravel na tela e o backend nunca o aplica.
///     Aqui ele vai pro complemento do lancamento de verdade
model CardPattern {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  /// Texto procurado na descricao da linha. Comparacao por "contem",
  /// normalizada (maiusculas, sem acento, espaco colapsado).
  texto           String   @db.VarChar(255)
  categoryId      String?  @map("category_id")
  supplierId      String?  @map("supplier_id")
  complementoAuto String?  @map("complemento_auto") @db.VarChar(255)
  /// Maior vence. No empate, decide o texto mais longo.
  prioridade      Int      @default(0)
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now()) @map("criado_em")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([tenantId, ativo])
  @@map("card_patterns")
}

model PeriodClosing {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  competencia DateTime  @db.Date
  status      String    @default("aberto") @db.VarChar(10)
  fechadoPor  String?   @map("fechado_por")
  fechadoEm   DateTime? @map("fechado_em")
  reabertoP   String?   @map("reaberto_por")
  reabertoEm  DateTime? @map("reaberto_em")

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  fechador User?  @relation("FechadoPor", fields: [fechadoPor], references: [id])
  reabrid  User?  @relation("ReabertoPor", fields: [reabertoP], references: [id])

  @@unique([tenantId, competencia])
  @@index([tenantId, competencia])
  @@map("period_closings")
}

model ExportLog {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  periodoInicio  DateTime @map("periodo_inicio") @db.Date
  periodoFim     DateTime @map("periodo_fim") @db.Date
  totalRegistros Int?     @map("total_registros")
  exportadoPor   String?  @map("exportado_por")
  exportadoEm    DateTime @default(now()) @map("exportado_em")
  nomeArquivo    String?  @map("nome_arquivo") @db.VarChar(255)

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  exportador User?  @relation(fields: [exportadoPor], references: [id])

  @@map("export_logs")
}

model Notification {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id")
  destinatarioId String?  @map("destinatario_id")
  tipo           String   @db.VarChar(50)
  titulo         String?  @db.VarChar(255)
  mensagem       String?
  lida           Boolean  @default(false)
  criadoEm       DateTime @default(now()) @map("criado_em")

  tenant       Tenant? @relation(fields: [tenantId], references: [id])

  @@map("notifications")
}

enum TipoDocumento {
  CPF
  CNPJ

  @@map("tipo_documento")
}

model Supplier {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  nome          String         @db.VarChar(200)
  documento     String?        @db.VarChar(20)
  tipoDocumento TipoDocumento? @map("tipo_documento")
  email         String?        @db.VarChar(150)
  telefone      String?        @db.VarChar(30)
  pessoaContato      String?  @map("pessoa_contato") @db.VarChar(150)
  emailsAdicionais   String[] @default([]) @map("emails_adicionais")
  cep                String?  @db.VarChar(8)
  logradouro         String?  @db.VarChar(255)
  numero             String?  @db.VarChar(20)
  complemento        String?  @db.VarChar(150)
  bairro             String?  @db.VarChar(100)
  cidade             String?  @db.VarChar(100)
  uf                 String?  @db.VarChar(2)
  inscricaoEstadual  String?  @map("inscricao_estadual") @db.VarChar(30)
  inscricaoMunicipal String?  @map("inscricao_municipal") @db.VarChar(30)
  endereco      String?        @db.Text
  observacao    String?        @db.Text
  ativo         Boolean        @default(true)
  criadoEm      DateTime       @default(now()) @map("criado_em")
  atualizadoEm  DateTime       @updatedAt      @map("atualizado_em")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  titles       Title[]
  transactions Transaction[]
  cardEntries  CardStatementEntry[]
  cardPatterns CardPattern[]

  @@index([tenantId, ativo])
  @@index([tenantId, nome])
  @@map("suppliers")
}

